            </aside>
            <div class="ab-main">
              <div class="ab-top">
                <div class="ab-city">⚜ Oslo ▾</div>
                <div class="right"><span>⌕</span><span class="ab-bell">🔔<b>19</b></span><span>⚙</span><span class="ab-ava"></span></div>
              </div>
              <div class="ab-content">
                <h1 class="ab-h1">Hjem</h1>
                <p class="ab-sub">Velkommen til HR-systemet for oslo</p>
                <div class="ab-herorow">
                  <div class="ab-hero">
                    <h2>Velkommen tilbake 👋</h2>
                    <p class="ab-heroname">Jehad</p>
                    <p class="ab-herotxt">Administrer din HR-avdeling effektivt med våre verktøy for ansatte, kunder og bestillinger.</p>
                    <span class="ab-cta">Kom i gang</span>
                  </div>
                  <div class="ab-news">
                    <span class="ab-newstag">Nyheter</span>
                    <div class="ab-newsimg"></div>
                    <div class="ab-newsbod"><b>Sommerferieplaner 2026</b><span>Informasjon om sommerferie og dekning</span></div>
                  </div>
                </div>
                <div class="ab-cards2">
                  <div class="ab-chart">
                    <h3>Ansatte per avdeling</h3><p class="ab-csub">Fordeling av ansatte</p>
                    <div class="ab-bars">
                      <div class="col"><div class="ab-bar" style="height:100%;background:#22b8cf"></div><span>Bergen</span><em>142</em></div>
                      <div class="col"><div class="ab-bar" style="height:48%;background:#ff6b4a"></div><span>Oslo</span><em>68</em></div>
                      <div class="col"><div class="ab-bar" style="height:26%;background:#22c55e"></div><span>Stavanger</span><em>37</em></div>
                      <div class="col"><div class="ab-bar" style="height:10%;background:#f6c445"></div><span>Agder</span><em>14</em></div>
                    </div>
                  </div>
                  <div class="ab-chart">
                    <h3>Kunder per avdeling</h3><p class="ab-csub">Fordeling av kunder</p>
                    <div class="ab-donutwrap">
                      <div class="ab-donut"><span>261</span></div>
                      <ul class="ab-legend">
                        <li><i style="background:#22b8cf"></i>Bergen <b>66%</b></li>
                        <li><i style="background:#22c55e"></i>Stavanger <b>15%</b></li>
                        <li><i style="background:#ff6b4a"></i>Oslo <b>14%</b></li>
                        <li><i style="background:#f6c445"></i>Agder <b>5%</b></li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <figcaption>Hjem — the overview dashboard</figcaption>
      </figure>

      <!-- SCREEN 4 — Meldinger -->
      <figure class="slide ab-slide">
        <div class="ab-win">
          <div class="ab-bar"><i class="ab-dot-r"></i><i class="ab-dot-y"></i><i class="ab-dot-g"></i><span class="ab-url">app.brobyggere.no/meldinger</span></div>
          <div class="ab-app">
            <aside class="ab-side">
              <div class="ab-logo">B<b>B</b>R</div>
              <div class="lbl">Management <span class="skjul">◂ Skjul</span></div>
