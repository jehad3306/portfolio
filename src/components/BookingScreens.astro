                ))}
              </nav>
            </aside>
            <div class="ab-main">
              <div class="ab-top">
                <div class="ab-city">⚜ Bergen ▾</div>
                <div class="right"><span>⌕</span><span class="ab-bell">🔔<b>19</b></span><span>⚙</span><span class="ab-ava"></span></div>
              </div>
              <div class="ab-content">
                <h1 class="ab-h1">Ansatte</h1>
                <p class="ab-sub">Administrer ansatte i bergen</p>
                <div class="ab-tabrow"><span class="on">Alle <small class="dark">251</small></span><span>Tilgjengelige</span><span>Slettede</span><span>Erfarne</span></div>
                <div class="ab-toolbar">
                  <span class="ab-search">Søk etter navn…</span>
                  <span class="ab-dots"><i style="background:#22c55e"></i><i style="background:#8b5cf6"></i><i style="background:#22b8cf"></i><i style="background:#f6c445"></i><i style="background:#cbd2da"></i><i style="background:#b4793a"></i><i style="background:#d58bf0"></i></span>
                  <span class="ab-add">＋ Ny ansatt</span>
                </div>
                <table class="ab-table">
                  <thead><tr><th>Navn</th><th>Adresse</th><th>Telefon</th><th>Kompetanse</th><th style="text-align:right">Status</th></tr></thead>
                  <tbody>
                    {employees.map((e) => (
                      <tr>
                        <td><div class="ab-nameC"><span class="pf"></span>{e.n}</div></td>
                        <td style="color:#596070">{e.a}</td>
                        <td style="color:#596070">{e.t}</td>
                        <td style="color:#596070">{e.k}</td>
                        <td style="text-align:right"><span class={`ab-badge ${e.s === 'Aktiv' ? 'aktiv' : 'erfaren'}`}>{e.s}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <div class="ab-tablefoot"><span>Viser 1-5 av 251 ansatte</span>
                  <div class="ab-pag"><span>‹</span><span class="on">1</span><span>2</span><span>3</span><span>…</span><span>51</span><span>›</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <figcaption>Ansatte — the employee register</figcaption>
      </figure>

      <!-- SCREEN 3 — Hjem -->
      <figure class="slide ab-slide">
        <div class="ab-win">
          <div class="ab-bar"><i class="ab-dot-r"></i><i class="ab-dot-y"></i><i class="ab-dot-g"></i><span class="ab-url">app.brobyggere.no/hjem</span></div>
          <div class="ab-app">
            <aside class="ab-side">
              <div class="ab-logo">B<b>B</b>R</div>
              <div class="lbl">Management <span class="skjul">◂ Skjul</span></div>
