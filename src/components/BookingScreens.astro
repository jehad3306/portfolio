---
<div class="slideshow appshow" id="bookShow">
  <div class="slviewport">
    <div class="sltrack">

      <!-- SCREEN 1 — Bestillinger -->
      <figure class="slide ab-slide">
        <div class="ab-win">
          <div class="ab-bar"><i class="ab-dot-r"></i><i class="ab-dot-y"></i><i class="ab-dot-g"></i><span class="ab-url">app.brobyggere.no/bestillinger</span></div>
          <div class="ab-app">
            <aside class="ab-side">
              <div class="ab-logo">B<b>B</b>R</div>
              <div class="lbl">Management <span class="skjul">◂ Skjul</span></div>
              <nav class="ab-nav">
                {nav.map((it) => (
                  <a class={`${it.label === 'Bestillinger' ? 'on' : ''} ${it.key === 'out' ? 'out' : ''}`}>
                    <svg viewBox="0 0 20 20" set:html={icons[it.key]}></svg>{it.label}
                  </a>
                ))}
              </nav>
            </aside>
            <div class="ab-main">
              <div class="ab-top">
                <div class="ab-city">⚜ Oslo ▾</div>
                <div class="right"><span>⌕</span><span class="ab-bell">🔔<b>19</b></span><span>⚙</span><span class="ab-ava"></span></div>
              </div>
              <div class="ab-content">
                <h1 class="ab-h1">Bestillinger</h1>
                <p class="ab-sub">Administrer bestillinger i oslo</p>
                <div class="ab-toolbar">
                  <span class="ab-search">Søk etter kunde…</span>
                  <span class="ab-pill" style="padding:8px 12px">3 per side ▾</span>
                  <span class="ab-add" style="background:#15a34a">⟳ Oppdater</span>
                </div>
                <div class="ab-filters"><span class="ab-chipx">✕</span><span class="ab-pill">2026 ▾</span><span class="ab-pill">September ▾</span><span class="ab-pill">▦ Alle dager</span></div>
                <div class="ab-stats">
                  <div class="ab-stat"><div class="k">Tildelt i dag</div><div class="v">8</div><div class="ab-up">▲ 33.3% <span style="color:#8a9099">vs i går</span></div></div>
                  <div class="ab-stat"><div class="k">Denne uken</div><div class="v">35</div><div class="ab-down">▼ 22.2% <span style="color:#8a9099">vs forrige uke</span></div></div>
                  <div class="ab-stat"><div class="k">Denne måneden</div><div class="v">130</div><div class="ab-up">▲ 34.0% <span style="color:#8a9099">vs forrige måned</span></div></div>
                </div>
                <div class="ab-tabs">
                  <span>Vanlige <small>0</small></span><span>Tildelte <small>0</small></span><span>Åpne vakter <small>0</small></span><span class="on">Fullførte <small>99</small></span>
                </div>
                <div class="ab-orders">
                  {orders.map((o) => (
                    <div class="ab-order">
                      <div class="ban"></div>
                      <div class="bod">
                        <div class="ab-cust">{o.c}</div>
                        <div class="ab-meta"><span>👤 1 Barnehageassistent</span><span>🗓 Mottatt: {o.rec}</span></div>
                        <div class="ab-row2"><span>📅 {o.d}</span><span>🕐 08:30 – 16:00</span></div>
                        <div class="ab-id">{o.id}</div>
                        <div class="ab-age"><span>Alder: <b>0-3 år</b></span><span>Avdeling: <b>{o.dep}</b></span></div>
                        <div class="ab-note">🙂 ingen kommentar</div>
                        <span class="ab-btn">↺ Ufullført</span>
                        <div class="ab-assigned">👥 TILDELT(E) ANSATTE</div>
                        <div class="ab-emp"><span class="pf"></span>{o.emp}</div>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="ab-pag"><span>«</span><span>‹</span><span>1</span><span class="on">2</span><span>3</span><span>4</span><span>…</span><span>33</span><span>›</span><span>»</span></div>
              </div>
            </div>
          </div>
        </div>
        <figcaption>Bestillinger — orders &amp; shift assignment</figcaption>
      </figure>

      <!-- SCREEN 2 — Ansatte -->
      <figure class="slide ab-slide">
        <div class="ab-win">
          <div class="ab-bar"><i class="ab-dot-r"></i><i class="ab-dot-y"></i><i class="ab-dot-g"></i><span class="ab-url">app.brobyggere.no/ansatte</span></div>
          <div class="ab-app">
            <aside class="ab-side">
              <div class="ab-logo">B<b>B</b>R</div>
              <div class="lbl">Management <span class="skjul">◂ Skjul</span></div>
