        <div class="ab-win">
          <div class="ab-bar"><i class="ab-dot-r"></i><i class="ab-dot-y"></i><i class="ab-dot-g"></i><span class="ab-url">app.brobyggere.no/tilbakemelding</span></div>
          <div class="ab-app">
            <aside class="ab-side">
              <div class="ab-logo">B<b>B</b>R</div>
              <div class="lbl">Management <span class="skjul">◂ Skjul</span></div>
              <nav class="ab-nav">
                {nav.map((it) => (
                  <a class={`${it.label === 'Tilbakemelding' ? 'on' : ''} ${it.key === 'out' ? 'out' : ''}`}>
                    <svg viewBox="0 0 20 20" set:html={icons[it.key]}></svg>{it.label}
                  </a>
                ))}
              </nav>
            </aside>
            <div class="ab-main">
              <div class="ab-top">
                <div class="ab-city">⚜ Bergen ▾</div>
                <div class="right"><span>⌕</span><span class="ab-bell">🔔<b>19</b></span><span>⚙</span><span class="ab-ava"></span></div>
              </div>
              <div class="ab-content">
                <h1 class="ab-h1">Tilbakemelding</h1>
                <p class="ab-sub">Oversikt over kunders vurderinger av ansatte</p>
                <div class="ab-fbhead">
                  <span class="ab-fbbadge bra">Bra 467</span>
                  <span class="ab-fbbadge ok">Ok 32</span>
                  <span class="ab-fbbadge forb">Forbedring 55</span>
                  <span class="ab-fbsearch">Søk etter ansatt, kunde eller kommentar…</span>
                </div>
                <div class="ab-fbgrid">
                  {feedback.map((f) => (
                    <div class={`ab-fbcard ${f.r}`}>
                      <div class="ab-fbtop">
                        <div class="ab-fbname"><span class="pf"></span>{f.n}</div>
                        <span class={`ab-rate ${f.r}`}>{f.r === 'bra' ? 'Bra' : 'Forbedring'}</span>
                      </div>
                      <div class="ab-fbbottom">
                        <span class={`ab-fbtxt ${f.t ? '' : 'empty'}`}>{f.t || 'Ingen kommentar'}</span>
